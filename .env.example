# ---------------------------------------------------------------------------
# MinIO Proxy Lab MPGO — variáveis de ambiente
# Copie para .env:  cp .env.example .env
# ---------------------------------------------------------------------------

# Credenciais do administrador do MinIO.
# Usadas apenas para tarefas de infraestrutura: criar bucket, subir o vídeo e
# criar o usuário de presign. NUNCA para assinar URLs.
# Trocar antes de qualquer uso fora do laboratório.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Credenciais do usuário dedicado que assina as URLs pré-assinadas.
#
# Por que existe: o access key de quem assina fica VISÍVEL na URL, no parâmetro
# X-Amz-Credential. Assinando com o root, qualquer pessoa que receba um link de
# vídeo passa a conhecer o usuário administrador do storage. Este usuário tem
# uma única permissão — s3:GetObject no bucket de vídeos — então o que vaza na
# URL é uma identidade que não consegue listar, gravar nem apagar nada.
#
# Criado por scripts/01-create-bucket.sh. É o que a aplicação real usaria.
MINIO_PRESIGN_USER=presign-videos
MINIO_PRESIGN_PASSWORD=presign-videos-123

# Bucket e objeto de teste
MINIO_BUCKET=videos
TEST_OBJECT=video-teste.mp4

# Hostname público do proxy — é ele que entra na assinatura SigV4.
# Precisa existir no arquivo de hosts da máquina apontando para 127.0.0.1.
PUBLIC_HOST=videos.lab.local
PUBLIC_SCHEME=https

# Portas publicadas pelo NGINX.
# ATENÇÃO: o NGINX escuta nestas mesmas portas DENTRO do container e elas estão
# fixas em nginx/nginx.conf. Alterar aqui exige alterar lá — use scripts/up.sh,
# que compara os dois arquivos antes de subir.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Validade da URL pré-assinada (formatos do mc: 30s, 15m, 6h, 24h; máximo 7d).
#
# 24h cobre com folga uma sessão de visualização inteira, incluindo pausas.
# O que importa aqui não é a duração do vídeo, e sim quanto tempo o player pode
# ficar aberto: a assinatura é conferida a CADA requisição, então uma URL que
# expira antes do fim faz o vídeo travar no próximo seek, no meio da sessão.
#
# O outro lado da moeda: a URL é um bearer token. Se vazar, vale até expirar e
# não há como revogar sem trocar a credencial que assinou. 24h é o equilíbrio
# adotado; para conteúdo mais sensível, reduzir para 6h ainda cobre um vídeo de
# 2 horas com margem confortável.
PRESIGN_EXPIRY=24h

# Origem do vídeo de teste, baixado por scripts/02-upload-test-video.sh quando
# assets/video-teste.mp4 não existir. (Big Buck Bunny, CC-BY Blender Foundation)
# Pode ser um .mp4 ou um .zip contendo o .mp4 — a origem abaixo só distribui a
# versão compactada, e o script extrai automaticamente.
TEST_VIDEO_URL=https://download.blender.org/peach/bigbuckbunny_movies/BigBuckBunny_320x180.mp4.zip

# Escotilha de emergência. Por padrão o mc valida o certificado do proxy usando
# nginx/certs/server.crt, montado como CA no container — é o comportamento que
# a aplicação real precisa ter. Só ligue (=1) se a validação atrapalhar algum
# teste pontual, e desligue em seguida.
MC_INSECURE=0
