# ---------------------------------------------------------------------------
# MinIO Proxy Lab MPGO — variáveis de ambiente
# Copie para .env:  cp .env.example .env
#
# O laboratório reproduz o formato decidido para produção: aplicação e mídia no
# MESMO host público, separadas por caminho.
#   https://intranet.lab.local:8443/themisia/     -> aplicação
#   https://intranet.lab.local:8443/memoriais/... -> objetos do MinIO
# ---------------------------------------------------------------------------

# Credenciais do administrador do MinIO.
# Usadas apenas para infraestrutura: criar bucket, subir vídeo, criar usuário.
# NUNCA para assinar URLs. Trocar antes de qualquer uso fora do laboratório.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Credenciais do usuário dedicado que assina as URLs pré-assinadas.
#
# Por que existe: o access key de quem assina fica VISÍVEL na URL, no parâmetro
# X-Amz-Credential. Em produção hoje as URLs saem assinadas com "minioadmin",
# ou seja, o administrador do storage vai para o navegador de todo usuário que
# abre um vídeo. Este usuário tem uma permissão só — s3:GetObject no bucket.
#
# Criado por scripts/01-create-bucket.sh.
MINIO_PRESIGN_USER=presign-memoriais
MINIO_PRESIGN_PASSWORD=presign-memoriais-123

# Bucket e objeto de teste.
#
# ATENÇÃO: o nome do bucket É o primeiro segmento do caminho na URL. Como a
# assinatura SigV4 cobre o caminho, o proxy não pode reescrevê-lo — não existe
# "prefixo livre". Servir em /memoriais/ exige que o bucket se chame memoriais.
#
# A chave imita a estrutura real do MemorIAis (UUID/TIPO/UUID.mp4) para exercitar
# barras dentro do nome do objeto atravessando o proxy.
MINIO_BUCKET=memoriais
TEST_OBJECT=019fb8eb-96a0-7ba3-9190-af5eac17f8f7/DEPOIMENTO/019fb8eb-b878-70e1-8692-095680ebef65.mp4

# Hostname público — simula intranet.mpgo.mp.br. É ele que entra na assinatura.
# Precisa existir no arquivo de hosts apontando para 127.0.0.1.
PUBLIC_HOST=intranet.lab.local
PUBLIC_SCHEME=https

# Hostname do MinIO, usado em dois lugares:
#   - no SNI da perna interna proxy -> MinIO (o certificado do MinIO cobre este nome);
#   - no player do caminho "quebrado", que reproduz o estado atual de produção.
# Simula vm-lnx-0369.intranet.mpgo. Também precisa estar no arquivo de hosts.
MINIO_DIRECT_HOST=vm-lnx-0369.lab.local

MINIO_DIRECT_PORT=9000

# Porta do console do MinIO, publicada direto no host para administração.
# Apresenta o certificado da ca-interna, então o navegador avisa — é o mesmo
# comportamento de produção e não atrapalha o laboratório.
# Em produção, https://vm-lnx-0369:9000/ redireciona para a :9001 quando
# acessado por navegador; o MINIO_BROWSER_REDIRECT_URL reproduz isso aqui.
MINIO_CONSOLE_PORT=9001

# Portas publicadas pelo NGINX.
# ATENÇÃO: o NGINX escuta nestas mesmas portas DENTRO do container e elas estão
# fixas em nginx/nginx.conf. Alterar aqui exige alterar lá — use scripts/up.sh,
# que compara os dois arquivos antes de subir.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Validade da URL pré-assinada (formatos do mc: 30s, 15m, 6h, 24h; máximo 7d).
#
# 24h cobre uma sessão inteira, incluindo pausas. O que importa não é a duração
# do vídeo, e sim quanto tempo o player pode ficar aberto: a assinatura é
# conferida a CADA requisição, então uma URL que expira antes do fim faz o vídeo
# travar no próximo seek, no meio da sessão.
#
# O outro lado: a URL é um bearer token. Se vazar, vale até expirar e não há
# revogação sem trocar a credencial. Para conteúdo mais sensível, 6h ainda cobre
# um vídeo de 2 horas com margem. (Produção hoje usa 8h.)
PRESIGN_EXPIRY=24h

# Mesmo valor em horas, para a aplicação FastAPI. Manter em sincronia.
PRESIGN_EXPIRY_HOURS=24

# Origem do vídeo de teste, baixado por scripts/02-upload-test-video.sh quando
# assets/video-teste.mp4 não existir. (Big Buck Bunny, CC-BY Blender Foundation)
# Pode ser .mp4 ou .zip contendo o .mp4 — o script detecta e extrai.
TEST_VIDEO_URL=https://download.blender.org/peach/bigbuckbunny_movies/BigBuckBunny_320x180.mp4.zip

# Escotilha de emergência. Por padrão o mc valida os certificados usando as CAs
# do laboratório, montadas no container — é o comportamento que a aplicação real
# precisa ter. Só ligue (=1) se a validação atrapalhar algum teste pontual.
MC_INSECURE=0
