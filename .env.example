# ---------------------------------------------------------------------------
# MinIO Proxy Lab MPGO — variáveis de ambiente
# Copie para .env:  cp .env.example .env
# ---------------------------------------------------------------------------

# Credenciais do MinIO (trocar antes de qualquer uso fora do laboratório)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Bucket e objeto de teste
MINIO_BUCKET=videos
TEST_OBJECT=video-teste.mp4

# Hostname público do proxy — é ele que entra na assinatura SigV4.
# Precisa existir no arquivo de hosts da máquina apontando para 127.0.0.1.
PUBLIC_HOST=videos.lab.local
PUBLIC_SCHEME=https

# Portas publicadas pelo NGINX.
# ATENÇÃO: o NGINX escuta nestas mesmas portas DENTRO do container.
# Host e container precisam bater, senão o Host assinado difere do Host recebido.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Expiração da URL pré-assinada (formatos aceitos pelo mc: 30s, 15m, 1h, 7d)
PRESIGN_EXPIRY=1h

# Origem do vídeo de teste, baixado por scripts/02-upload-test-video.sh quando
# assets/video-teste.mp4 não existir. (Big Buck Bunny, CC-BY Blender Foundation)
# Pode ser um .mp4 ou um .zip contendo o .mp4 — a origem abaixo só distribui a
# versão compactada, e o script extrai automaticamente.
TEST_VIDEO_URL=https://download.blender.org/peach/bigbuckbunny_movies/BigBuckBunny_320x180.mp4.zip
