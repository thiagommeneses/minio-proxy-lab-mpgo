# Credenciais do MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Usuário que só lê o bucket. É ele que assina as URLs dos vídeos.
# O access key de quem assina aparece na URL, então não pode ser o root.
MINIO_LEITOR_USER=leitor-videos
MINIO_LEITOR_PASSWORD=leitor-videos-123

# Bucket e o vídeo de teste dentro dele
MINIO_BUCKET=memoriais
TEST_OBJECT=depoimento.mp4

# Hostname da aplicação (simula intranet.mpgo.mp.br)
APP_HOST=intranet.lab.local

# Hostname do MinIO (simula vm-lnx-0369.intranet.mpgo)
MINIO_HOST=vm-lnx-0369.lab.local

# Quanto tempo a URL pré-assinada vale
EXPIRA_HORAS=24

# Vídeo baixado no primeiro start
VIDEO_URL=https://download.blender.org/peach/bigbuckbunny_movies/BigBuckBunny_320x180.mp4.zip
